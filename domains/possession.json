{
  "id": "possession",
  "version": "1.0.0",
  "label": "Possession / Tenure",
  "labelKey": "dsl.possession.domain.label",
  "defaultCategoryId": "ownership",
  "validationMode": "flexible",
  "applicableLayers": ["pertenenze"],
  "categories": [
    { "id": "ownership",       "label": "Ownership",         "labelKey": "dsl.possession.category.ownership",       "color": "#2e7d32", "stroke": "#1b5e20" },
    { "id": "bare_ownership",  "label": "Bare ownership",    "labelKey": "dsl.possession.category.bare_ownership",  "color": "#66bb6a", "stroke": "#2e7d32" },
    { "id": "usufruct",        "label": "Usufruct",          "labelKey": "dsl.possession.category.usufruct",        "color": "#9ccc65", "stroke": "#558b2f" },
    { "id": "lease",           "label": "Lease",             "labelKey": "dsl.possession.category.lease",           "color": "#fbc02d", "stroke": "#9a7d0a" },
    { "id": "loan_for_use",    "label": "Loan for use",      "labelKey": "dsl.possession.category.loan_for_use",    "color": "#ffd54f", "stroke": "#c8a200" },
    { "id": "emphyteusis",     "label": "Emphyteusis",       "labelKey": "dsl.possession.category.emphyteusis",     "color": "#8d6e63", "stroke": "#4e342e" },
    { "id": "concession",      "label": "Concession",        "labelKey": "dsl.possession.category.concession",      "color": "#7e57c2", "stroke": "#4527a0" },
    { "id": "other",           "label": "Other",             "labelKey": "dsl.possession.category.other",           "color": "#b0bec5", "stroke": "#546e7a" }
  ],
  "fields": [
    { "id": "quota_percent",   "type": "number", "label": "Share (%)",         "labelKey": "dsl.possession.field.quota_percent", "required": false },
    { "id": "holder_name",     "type": "string", "label": "Holder name",       "labelKey": "dsl.possession.field.holder_name",   "required": false },
    { "id": "holder_cuaa",     "type": "string", "label": "Holder CUAA",       "labelKey": "dsl.possession.field.holder_cuaa",   "required": false },
    { "id": "document_ref",    "type": "string", "label": "Document reference","labelKey": "dsl.possession.field.document_ref",  "required": false },
    { "id": "document_date",   "type": "date",   "label": "Document date",     "labelKey": "dsl.possession.field.document_date", "required": false },
    { "id": "expiry_date",     "type": "date",   "label": "Expiry date",       "labelKey": "dsl.possession.field.expiry_date",   "required": false },
    { "id": "notes",           "type": "string", "label": "Notes",             "labelKey": "dsl.possession.field.notes",         "required": false }
  ]
}
